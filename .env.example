# Cloudflare deployment CLI only; never sent to browser or app users.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Application runtime. Generate a 32-byte random encryption secret once.
# Keep stable: changing it prevents decryption of existing BYOK credentials.
ENCRYPTION_KEY=
APP_URL=http://localhost:8787
ALLOW_REGISTRATION=true
PORT=8787
DATA_DIR=.data

# Optional Google Slides browser OAuth client (public client ID, not a secret).
GOOGLE_CLIENT_ID=

# Optional GitHub login. Callback must use this deployment's APP_URL origin.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8787/api/auth/github/callback

# Agent client environment
DESIGN_STUDIO_URL=https://studio.agentkit.best
DESIGN_STUDIO_API_KEY=

# Operational visibility; comma-separated existing account IDs, never all users.
OBSERVABILITY_ADMIN_IDS=
# Optional PostHog project ingestion token and verified project region/custom host.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=

# Separate OAuth client and Picker project for selected Drive files.
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# Separate selected-repository GitHub App (does not widen login OAuth)
GITHUB_CONNECTOR_CLIENT_ID=
GITHUB_CONNECTOR_CLIENT_SECRET=
GITHUB_CONNECTOR_APP_ID=
GITHUB_CONNECTOR_PRIVATE_KEY=
GITHUB_CONNECTOR_WEBHOOK_SECRET=

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "design-studio-ai",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*", "/published/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "design-studio-ai", "database_id": "920d59d1-d4e9-4e8b-b01b-9dbf45a180aa", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "design-studio-ai-assets" }],
  "vars": { "APP_URL": "https://studio.agentkit.best", "ALLOW_REGISTRATION": "true" },
  "routes": [{ "pattern": "studio.agentkit.best", "custom_domain": true }],
  "observability": { "enabled": true },
  "browser": { "binding": "BROWSER" },
  "limits": { "cpu_ms": 30000 },
  "env": {
    "beta": {
      "name": "design-studio-ai-beta",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "beta.studio.agentkit.best",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_URL": "https://beta.studio.agentkit.best",
        "ALLOW_REGISTRATION": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "design-studio-ai-beta",
          "database_id": "d9a0325a-1a4c-46bd-b696-c0ed724a0881",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "design-studio-ai-assets-beta"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      }
    }
  }
}

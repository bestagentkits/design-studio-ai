{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "design-studio-ai",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*", "/published/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "design-studio-ai", "database_id": "920d59d1-d4e9-4e8b-b01b-9dbf45a180aa", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "design-studio-ai-assets" }],
  "vars": { "APP_URL": "https://studio.agentkit.best", "ALLOW_REGISTRATION": "true" },
  "routes": [{ "pattern": "studio.agentkit.best", "custom_domain": true }],
  "observability": { "enabled": true },
  "queues":{"producers":[{"binding":"OPERATION_QUEUE","queue":"design-studio-operations"}],"consumers":[{"queue":"design-studio-operations","max_batch_size":1,"max_batch_timeout":1,"max_concurrency":1,"max_retries":20}]},
  "browser": { "binding": "BROWSER" },
  "limits": { "cpu_ms": 30000 }
}
